---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import { getCollection, getEntry, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import NewsEntry from "@/components/NewsEntry.astro"
import RichText from "@/components/RichText.astro"
import { obfuscateEmail, type ProfileEntry } from "@/lib/contact"
import "@/styles/pages/home.scss"

import oimImg from "@/assets/oim.png"
import phoneImg from "@/assets/phone.png"
import emailImg from "@/assets/email.png"
import scholarImg from "@/assets/google-scholar.png"
import kaggleImg from "@/assets/kaggle.png"
import researchGateImg from "@/assets/research-gate.png"
import arxivImg from "@/assets/arxiv.png"
import xImg from "@/assets/x.png"
import linkedinImg from "@/assets/linkedin-in.png"
import githubImg from "@/assets/github.png"

const allNews: CollectionEntry<"news">[] = await getCollection("news")
const recentNews = allNews.slice(0, 5)

// Contact details and interests live in data/personal.yaml so the site and the
// Typst CVs can never drift apart. Icon and optical height stay here — they are
// presentation, not data.
const icons: Record<string, { src: ImageMetadata; height: number }> = {
    scholar: { src: scholarImg, height: 16 },
    kaggle: { src: kaggleImg, height: 16 },
    researchgate: { src: researchGateImg, height: 16 },
    arxiv: { src: arxivImg, height: 16 },
    // The X mark, not the retired bird. This is the file that used to sit on
    // the arXiv row, where a bare X read as this logo rather than as arXiv.
    twitter: { src: xImg, height: 14 },
    linkedin: { src: linkedinImg, height: 15 },
    github: { src: githubImg, height: 15 },
}

interface Contact {
    entry: ProfileEntry
    icon: { src: ImageMetadata; height: number }
}

const personal = await getEntry("personal", "main")
const profileEntries: Record<string, ProfileEntry> = personal?.data.profile_entries ?? {}
const slugs: string[] = personal?.data.profiles_web ?? []
const profiles: Contact[] = slugs
    .map((slug) => ({ entry: profileEntries[slug], icon: icons[slug] }))
    .filter((profile): profile is Contact => Boolean(profile.entry && profile.icon))

const phone: string | undefined = personal?.data.phone
const emails: Array<{ address: string; academic_only?: boolean }> = personal?.data.emails ?? []
const primaryEmail = emails.find((email) => !email.academic_only)?.address
const interests: string | undefined = personal?.data.interests_academic

// Prose lives in data/personal.yaml rather than here, so an affiliation change
// lands in one file instead of drifting between the homepage and the CVs.
const bio: string[] = personal?.data.bio_web ?? []
---

<Layout
    title="Oshan Mudannayake | AI Researcher"
    description="Lead ML Engineer at ParadigmAI; research interests in reinforcement learning, computer games, and intelligent agents."
>
    <div class="homeLayout section-wrapper">
        <div class="section-items">
            <div class="about-me">
                <div class="profile-card">
                    <div class="img-container">
                        {
                            /* eager only says "do not lazy-load"; it still queues at
                            default priority behind the nine contact icons below.
                            This is the LCP element on the one page that has one. */
                        }
                        <Image
                            src={oimImg}
                            alt="Oshan Mudannayake profile photo"
                            width={500}
                            height={540}
                            class="article-img"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                    <div class="profile-description">
                        <h2>Hello world!</h2>
                        {
                            bio.map((paragraph) => (
                                <p class="content-text">
                                    <RichText text={paragraph} />
                                </p>
                            ))
                        }
                    </div>
                </div>
                <div class="contact-details-section">
                    <div class="contact-details">
                        {
                            phone && (
                                <div class="contact-item">
                                    <Image src={phoneImg} alt="" aria-hidden="true" height={14} />
                                    <span>{phone}</span>
                                </div>
                            )
                        }
                        {
                            primaryEmail && (
                                <div class="contact-item">
                                    <Image src={emailImg} alt="" aria-hidden="true" height={11} />
                                    <span>{obfuscateEmail(primaryEmail)}</span>
                                </div>
                            )
                        }
                        {
                            profiles.map(({ entry, icon }) => (
                                <div class="contact-item">
                                    <Image src={icon.src} alt="" aria-hidden="true" height={icon.height} />
                                    <span>
                                        <a class="link" href={entry.url} target="_blank" rel="noopener noreferrer">
                                            {entry.label_web ?? entry.label}
                                        </a>
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <div class="research-interests">
                <h2>Research Interests</h2>
                <span>{interests}</span>
            </div>
            <div class="news-section">
                <h2>News</h2>
                {recentNews.map((entry) => <NewsEntry entry={entry.data} />)}
                <div class="news-content">
                    <span><a class="link" href="/news">[See more]</a></span>
                </div>
            </div>
        </div>
    </div>
</Layout>
