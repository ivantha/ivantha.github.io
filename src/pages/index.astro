---
import { Image } from "astro:assets"
import { getCollection, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import NewsEntry from "@/components/NewsEntry.astro"
import { orgs } from "@/data/orgs"
import "@/styles/pages/home.scss"

import oimImg from "@/assets/oim.png"
import phoneImg from "@/assets/phone.png"
import emailImg from "@/assets/email.png"
import scholarImg from "@/assets/google-scholar.png"
import kaggleImg from "@/assets/kaggle.png"
import researchGateImg from "@/assets/research-gate.png"
import arxivImg from "@/assets/arxiv.png"
import twitterImg from "@/assets/twitter.png"
import linkedinImg from "@/assets/linkedin-in.png"
import githubImg from "@/assets/github.png"

const allNews: CollectionEntry<"news">[] = await getCollection("news")
const recentNews = allNews.slice(0, 5)
---

<Layout
    title="Oshan Mudannayake | AI Researcher"
    description="Lead ML Engineer at ParadigmAI; research interests in reinforcement learning, computer games, and intelligent agents."
>
    <div class="homeLayout section-wrapper">
        <div class="section-items">
            <div class="about-me">
                <div class="profile-card">
                    <div class="img-container">
                        <Image src={oimImg} alt="Oshan Mudannayake profile photo" class="article-img" loading="eager" />
                    </div>
                    <div class="profile-description">
                        <h2>Hello world!</h2>
                        <span class="content-text">
                            I am the Lead ML Engineer at{" "}
                            <a class="link" href={orgs.paradigmai.url} target="_blank" rel="noopener noreferrer"
                                >{orgs.paradigmai.shortname}</a
                            >. I graduated from{" "}
                            <a class="link" href={orgs.ucsc.url} target="_blank" rel="noopener noreferrer"
                                >{orgs.ucsc.shortname}</a
                            > with an honours degree in Computer Science and am currently reading for an M.Sc in Data Science
                            & AI at the University of Moratuwa.
                            <br />
                            My research interests primarily lie in the intersection of reinforcement learning and computer
                            games. I am particularly interested in studying about intelligent agents that improve with experience.
                            <br />
                            In a much broader sense, I like to work on theoretical and application research topics involving
                            artificial intelligence.
                        </span>
                    </div>
                </div>
                <div class="contact-details-section">
                    <div class="contact-details">
                        <div class="contact-item">
                            <Image src={phoneImg} alt="Phone" height={14} />
                            <span>(+94) 71 908 4020</span>
                        </div>
                        <div class="contact-item">
                            <Image src={emailImg} alt="Email" height={11} />
                            <span>oshan [DOT] ivantha [AT] g**** [DOT] com</span>
                        </div>
                        <div class="contact-item">
                            <Image src={scholarImg} alt="Google Scholar" height={16} />
                            <span>
                                <a
                                    class="link"
                                    href="https://scholar.google.com/citations?user=2FA0RngAAAAJ&hl=en"
                                    target="_blank"
                                    rel="noopener noreferrer">Google Scholar</a
                                >
                            </span>
                        </div>
                        <div class="contact-item">
                            <Image src={kaggleImg} alt="Kaggle" height={16} />
                            <span>
                                <a
                                    class="link"
                                    href="https://www.kaggle.com/ivantha"
                                    target="_blank"
                                    rel="noopener noreferrer">Kaggle</a
                                >
                            </span>
                        </div>
                        <div class="contact-item">
                            <Image src={researchGateImg} alt="ResearchGate" height={16} />
                            <span>
                                <a
                                    class="link"
                                    href="https://www.researchgate.net/profile/Oshan-Mudannayake"
                                    target="_blank"
                                    rel="noopener noreferrer">ResearchGate</a
                                >
                            </span>
                        </div>
                        <div class="contact-item">
                            <Image src={arxivImg} alt="arXiv" height={16} />
                            <span>
                                <a
                                    class="link"
                                    href="https://arxiv.org/search/cs?searchtype=author&query=Mudannayake%2C+O"
                                    target="_blank"
                                    rel="noopener noreferrer">arXiv</a
                                >
                            </span>
                        </div>
                        <div class="contact-item">
                            <Image src={twitterImg} alt="Twitter" height={13} />
                            <span>
                                <a
                                    class="link"
                                    href="https://twitter.com/_ivantha"
                                    target="_blank"
                                    rel="noopener noreferrer">_ivantha</a
                                >
                            </span>
                        </div>
                        <div class="contact-item">
                            <Image src={linkedinImg} alt="LinkedIn" height={15} />
                            <span>
                                <a
                                    class="link"
                                    href="https://www.linkedin.com/in/ivantha/"
                                    target="_blank"
                                    rel="noopener noreferrer">ivantha</a
                                >
                            </span>
                        </div>
                        <div class="contact-item">
                            <Image src={githubImg} alt="GitHub" height={15} />
                            <span>
                                <a
                                    class="link"
                                    href="https://github.com/ivantha"
                                    target="_blank"
                                    rel="noopener noreferrer">ivantha</a
                                >
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="research-interests">
                <h2>Research Interests</h2>
                <span>Reinforcement Learning | Machine Learning | Artificial Intelligence</span><br />
                <span>Game Theory | Computer Games</span><br />
                <span>Computer Vision</span>
            </div>
            <div class="news-section">
                <h2>News</h2>
                {recentNews.map((entry) => <NewsEntry entry={entry.data} />)}
                <div class="news-content">
                    <span><a class="link" href="/news">[See more]</a></span>
                </div>
            </div>
        </div>
    </div>
</Layout>
