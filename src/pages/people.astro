---
import Layout from "@/layouts/Layout.astro"
import { people } from "@/data/people"
import "@/styles/pages/people.scss"

const alphabeticalList = [
    people.amilaindika,
    people.dilrukshigamage,
    people.dinalherath,
    people.dinunifernando,
    people.disnirathnayake,
    people.gihanseneviratne,
    people.harindasamarasekara,
    people.mohammadnabeel,
    people.nalinranasinghe,
    people.noelfernando,
    people.sumedhedissanayake,
    people.thanujaambegoda,
    people.upuljayasinghe,
]
---

<Layout
    title="People | Oshan Mudannayake"
    description="Collaborators, advisors, and colleagues across research projects."
>
    <div class="peopleLayout section-wrapper">
        <div class="section-title">
            <h1>People</h1>
        </div>
        <div class="section-items">
            {
                /* These are running sentences, so they take `.content-text` and
                nothing else. An inner `.institute-text` used to override it,
                setting whole sentences in the muted metadata style reserved for
                dates and positions.

                Anchor text stays on the tag's own line even where that overruns
                the print width. Template-level markup keeps the whitespace Astro
                finds, so breaking after `<a>` puts a space inside the link — it
                rendered as "Dr. Dinal Herath ," and widened the hover underline.
                Markup inside a callback is trimmed instead and needs no such
                care; see src/components/RichText.astro. */
            }
            <h2>Present Affiliations</h2>
            <ul class="alt-people-wrapper">
                <li class="content-text">
                    I am advised by{" "}
                    <a class="link" href={people.thanujaambegoda.link} target="_blank" rel="noopener noreferrer"
                        >{people.thanujaambegoda.namewithhonorifics}</a
                    > on my master&rsquo;s thesis at the University of Moratuwa.
                </li>
                <li class="content-text">
                    I am working with{" "}
                    <a class="link" href={people.dilrukshigamage.link} target="_blank" rel="noopener noreferrer"
                        >{people.dilrukshigamage.namewithhonorifics}</a
                    > on deepfake detection in South Asia.
                </li>
                <li class="content-text">
                    I am a visiting researcher at{" "}
                    <a class="link" href="https://www.kixlab.org/people" target="_blank" rel="noopener noreferrer"
                        >KIXLAB (KAIST Interaction Lab)</a
                    >.
                </li>
                <li class="content-text">
                    I am collaborating with{" "}
                    <a class="link" href={people.harindasamarasekara.link} target="_blank" rel="noopener noreferrer"
                        >{people.harindasamarasekara.name}</a
                    >{" "}and{" "}
                    <a class="link" href={people.sumedhedissanayake.link} target="_blank" rel="noopener noreferrer"
                        >{people.sumedhedissanayake.name}</a
                    > on improving the current state of the Sinhala OCR.
                </li>
            </ul>
            <h2>Past Affiliations</h2>
            <ul class="alt-people-wrapper">
                <li class="content-text">
                    I collaborated with{" "}
                    <a class="link" href={people.amilaindika.link} target="_blank" rel="noopener noreferrer"
                        >{people.amilaindika.name}</a
                    >{" "}and{" "}
                    <a class="link" href={people.upuljayasinghe.link} target="_blank" rel="noopener noreferrer"
                        >{people.upuljayasinghe.namewithhonorifics}</a
                    > on &ldquo;Privacy Preserved Machine Learning using Secure Multi-party Computing&rdquo;, which was published
                    in 2025.
                </li>
                <li class="content-text">
                    I was instructed by{" "}
                    <a class="link" href={people.dinalherath.link} target="_blank" rel="noopener noreferrer"
                        >{people.dinalherath.namewithhonorifics}</a
                    >,{" "}
                    <a class="link" href={people.dinunifernando.link} target="_blank" rel="noopener noreferrer"
                        >{people.dinunifernando.namewithhonorifics}</a
                    >, and{" "}
                    <a class="link" href={people.noelfernando.link} target="_blank" rel="noopener noreferrer"
                        >{people.noelfernando.namewithhonorifics}</a
                    > on &ldquo;Modeling and Prediction of Municipal Solid Waste Generation in Sri Lanka using Machine Learning
                    Techniques&rdquo;, which was published in 2022.
                </li>
                <li class="content-text">
                    I was advised by{" "}
                    <a class="link" href={people.nalinranasinghe.link} target="_blank" rel="noopener noreferrer"
                        >{people.nalinranasinghe.namewithhonorifics}</a
                    > in my bachelor&rsquo;s thesis at UCSC.
                </li>
            </ul>
            <h2>Alphabetical List</h2>
            <ul class="people-wrapper">
                {
                    alphabeticalList.map((person) => (
                        <li class="content-text">
                            {person.namewithhonorifics}
                            <br />
                            <span class="institute-text">{person.position}</span>
                            <br />
                            <span class="institute-text">
                                {person.web && (
                                    <a class="link" href={person.web} target="_blank" rel="noopener noreferrer">
                                        [Web]{" "}
                                    </a>
                                )}
                                {person.linkedin && (
                                    <a class="link" href={person.linkedin} target="_blank" rel="noopener noreferrer">
                                        [LinkedIn]{" "}
                                    </a>
                                )}
                                {person.scholar && (
                                    <a class="link" href={person.scholar} target="_blank" rel="noopener noreferrer">
                                        [Google Scholar]
                                    </a>
                                )}
                                {person.researchgate && (
                                    <a
                                        class="link"
                                        href={person.researchgate}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        [ResearchGate]
                                    </a>
                                )}
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</Layout>
