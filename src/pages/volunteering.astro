---
import { getCollection, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import "@/styles/pages/volunteering.scss"

const mentoring: CollectionEntry<"mentoring">[] = await getCollection("mentoring")
const committees: CollectionEntry<"volunteering">[] = await getCollection("volunteering")
---

<Layout title="Volunteering | Oshan Mudannayake" description="Mentoring, judging, and committee volunteering history.">
    <div class="volunteeringLayout section-wrapper">
        <div class="section-title">
            <h1>Volunteering</h1>
        </div>
        <div class="section-items">
            {
                mentoring.length > 0 && (
                    <div>
                        <h2 class="research-subtitle">Mentoring</h2>
                        <ul>
                            {mentoring.map((entry) => (
                                <li class="volunteering-wrapper">
                                    <h3>{entry.data.line}</h3>
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
            {mentoring.length > 0 && committees.length > 0 && <div class="volunteering-divider" />}
            {
                committees.length > 0 && (
                    <div>
                        <h2 class="volunteering-subtitle">Committee Positions</h2>
                        <ul>
                            {committees.map((entry) => (
                                <li class="volunteering-wrapper">
                                    <h3>{entry.data.line}</h3>
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
        </div>
    </div>
</Layout>
