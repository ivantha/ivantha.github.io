---
import { getCollection, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import ResearchItem from "@/components/ResearchItem.astro"
import { isWebVisible } from "@/lib/variants"

const all: CollectionEntry<"research">[] = await getCollection("research")
const items = all.filter((entry) => isWebVisible(entry.data))

// File order is the display order, so partition rather than sort.
const sections = [
    { label: "Ongoing", entries: items.filter((entry) => entry.data.status === "ongoing") },
    { label: "Completed", entries: items.filter((entry) => entry.data.status === "completed") },
]
---

<Layout
    title="Research | Oshan Mudannayake"
    description="Ongoing and completed research projects across RL, time-series, privacy-preserving ML, and computer vision."
>
    <div class="researchLayout section-wrapper">
        <div class="section-title">
            <h1>Research</h1>
        </div>
        <div class="section-items">
            {
                sections.map(
                    ({ label, entries }) =>
                        entries.length > 0 && (
                            <div>
                                <h2>{label}</h2>
                                <ul>
                                    {entries.map(({ data }) => (
                                        <ResearchItem item={data} />
                                    ))}
                                </ul>
                            </div>
                        ),
                )
            }
        </div>
    </div>
</Layout>
