---
import { getCollection, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"

const TYPE_LABEL: Record<string, string> = {
    oral: "Oral Presentations",
    poster: "Poster Presentations",
    invited: "Invited Talks",
}

const talks: CollectionEntry<"talks">[] = await getCollection("talks")
const grouped = (["oral", "poster", "invited"] as const)
    .map((type) => ({
        type,
        items: talks.filter((entry) => entry.data.type === type),
    }))
    .filter((g) => g.items.length > 0)
---

<Layout title="Talks | Oshan Mudannayake" description="Oral, poster, and invited talks given by Oshan Mudannayake.">
    <div class="talksLayout section-wrapper">
        <div class="section-title">
            <h1>Talks</h1>
        </div>
        <div class="section-items">
            {
                grouped.map((group) => (
                    <div>
                        <h2>{TYPE_LABEL[group.type]}</h2>
                        <ul>
                            {group.items.map((entry) => (
                                <li>
                                    <h3>
                                        {entry.data.date} | {entry.data.title}
                                    </h3>
                                    {entry.data.venue && (
                                        <span class="content-text">
                                            {entry.data.venue}
                                            {entry.data.location && ` | ${entry.data.location}`}
                                        </span>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</Layout>
