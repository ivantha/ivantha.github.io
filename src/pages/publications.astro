---
import { getCollection, getEntry, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import PublicationItem from "@/components/PublicationItem.astro"
import "@/styles/pages/publications.scss"

const publications = await getEntry("publications", "main")
const items = publications?.data.items ?? []
const sorted = [...items].sort((a, b) => (b.year ?? 0) - (a.year ?? 0))
// A preprint keeps its arXiv link in `doi_url`, so the venue type, not the
// link, is what separates it from a published article.
const published = sorted.filter((p) => p.doi_url && p.venue_type !== "Preprint")
const preprints = sorted.filter((p) => p.venue_type === "Preprint")
const underReview = sorted.filter((p) => !p.doi_url && p.venue_type !== "Preprint")
const drafts: CollectionEntry<"in-preparation">[] = await getCollection("in-preparation")
const inPreparation = drafts.map(({ data }) => ({ ...data, venue_type: "Manuscript" }))
const note = publications?.data.equal_contribution_note
const hasEqContrib = (list: { authors?: { equal_contribution?: boolean }[] }[]) =>
    list.some((p) => (p.authors ?? []).some((a) => a.equal_contribution))
const hasEqContribInPublished = hasEqContrib(published)
const hasEqContribInPreprints = hasEqContrib(preprints)
---

<Layout
    title="Publications | Oshan Mudannayake"
    description="Peer-reviewed publications, preprints, and articles under review."
>
    <div class="publicationsLayout section-wrapper">
        <div class="section-title">
            <h1>Publications</h1>
        </div>
        <div class="section-items">
            {
                published.length > 0 && (
                    <>
                        <h2>Published Articles</h2>
                        <ul>
                            {published.map((pub) => (
                                <PublicationItem pub={pub} />
                            ))}
                        </ul>
                        {hasEqContribInPublished && note && (
                            <p>
                                <sup>*</sup> {note}
                            </p>
                        )}
                    </>
                )
            }
            {
                underReview.length > 0 && (
                    <>
                        <h2>Articles Under Review</h2>
                        <ul>
                            {underReview.map((pub) => (
                                <PublicationItem pub={pub} />
                            ))}
                        </ul>
                    </>
                )
            }
            {
                preprints.length > 0 && (
                    <>
                        <h2>Preprints</h2>
                        <ul>
                            {preprints.map((pub) => (
                                <PublicationItem pub={pub} />
                            ))}
                        </ul>
                        {hasEqContribInPreprints && note && (
                            <p>
                                <sup>*</sup> {note}
                            </p>
                        )}
                    </>
                )
            }
            {
                inPreparation.length > 0 && (
                    <>
                        <h2>Manuscripts in Preparation</h2>
                        <ul>
                            {inPreparation.map((pub) => (
                                <PublicationItem pub={pub} />
                            ))}
                        </ul>
                    </>
                )
            }
        </div>
    </div>
</Layout>
