---
import RichText from "@/components/RichText.astro"

interface Props {
    entry: {
        date: string
        content: string
    }
}

const { entry } = Astro.props
---

<div class="news-content">
    <span class="date-text">{entry.date}</span><br />
    <span class="content-text"><RichText text={entry.content} /></span>
</div>
