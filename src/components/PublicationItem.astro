---
import type { CollectionEntry } from "astro:content"
import TypstMd from "@/components/TypstMd.astro"

type Pub = CollectionEntry<"publications">["data"]["items"][number]
type Author = Pub["authors"][number]

interface Props {
    pub: Pub
}

const { pub } = Astro.props

const title = pub.title_casual ?? pub.title
const venue = pub.venue_casual ?? pub.venue
const authors: Author[] = pub.authors ?? []
---

<li>
    <p>
        {
            /* A label, not emphasis — so <span>, not <strong>. The literal
            brackets go with it; the chip's border carries that job now. */
        }
        <span class="venue-tag">{pub.venue_type}</span>{" "}
        <TypstMd text={title} />
        {
            authors.length > 0 && (
                <>
                    <br />
                    <span>
                        {authors.map((author: Author, i: number) => (
                            <>
                                {i > 0 && ", "}
                                {author.self ? <strong>{author.name}</strong> : author.name}
                                {author.equal_contribution && <sup>*</sup>}
                            </>
                        ))}
                    </span>
                </>
            )
        }
        {
            venue && (
                <>
                    <br />
                    {/* The comma rides inside the <em> on purpose. Astro renders
                        the line break below as a space, so with the comma out
                        here it lands before the comma ("venue , 2026") — and
                        prettier reflows any one-line workaround. Year stays
                        roman, as in the citation styles this mirrors. */}
                    <em>{pub.year ? `${venue},` : venue}</em>
                    {pub.year}
                </>
            )
        }
        {(pub.doi_url || pub.pdf_url) && <br />}
        {
            pub.doi_url && (
                <a class="link" href={pub.doi_url} target="_blank" rel="noopener noreferrer">
                    {`[${pub.doi_label ?? "DOI"}]`}
                </a>
            )
        }
        {pub.doi_url && pub.pdf_url && " "}
        {
            pub.pdf_url && (
                <a class="link" href={pub.pdf_url} target="_blank" rel="noopener noreferrer">
                    [PDF]
                </a>
            )
        }
    </p>
</li>
