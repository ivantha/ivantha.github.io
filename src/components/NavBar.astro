---
const links: Array<{ href: string; label: string; external?: boolean }> = [
    { href: "/", label: "Home" },
    { href: "/research", label: "Research" },
    { href: "/publications", label: "Publications" },
    { href: "/experience", label: "Experience" },
    { href: "/education", label: "Education" },
    { href: "/projects", label: "Projects" },
    { href: "/open-source", label: "Open Source" },
    { href: "/certifications", label: "Certifications" },
    { href: "/achievements", label: "Achievements" },
    { href: "/workshops", label: "Workshops" },
    { href: "/talks", label: "Talks" },
    { href: "/volunteering", label: "Volunteering" },
    { href: "/people", label: "People" },
    { href: "/news", label: "News" },
    { href: "/articles", label: "Articles" },
    { href: "/cv/academic-cv.pdf", label: "CV", external: true },
    { href: "/about", label: "About" },
]

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
---

{
    /* Closed by default, which is the correct state for mobile; desktop forces it
    open with CSS only (see components/_navbar.scss). No client-side JS. */
}
<details class="site-nav">
    <summary>Menu</summary>
    <nav class="navbar" aria-label="Main">
        {
            links.map(({ href, label, external }) => {
                const isActive = !external && (href === "/" ? currentPath === "/" : currentPath.startsWith(href))
                const className = isActive ? "active" : undefined
                return external ? (
                    // `external` here means "opens in a new tab", not "another
                    // origin" — the CV is a local PDF, so site-wide prefetch would
                    // happily pull ~190 kB on hover. Opt it out explicitly.
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={className}
                        data-astro-prefetch="false"
                    >
                        {label}
                    </a>
                ) : (
                    <a href={href} class={className} aria-current={isActive ? "page" : undefined}>
                        {label}
                    </a>
                )
            })
        }
    </nav>
</details>
