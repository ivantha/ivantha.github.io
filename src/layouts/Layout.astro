---
import { getEntry } from "astro:content"
import "@/styles/components/layout.scss"
import NavBar from "@/components/NavBar.astro"
import type { ProfileEntry } from "@/lib/contact"
import { commandFor } from "@/lib/prompt"

interface Props {
    title?: string
    description?: string
}

const { title, description = "Personal website of Oshan Mudannayake — AI Researcher and ML Engineer." } = Astro.props

const fullTitle = title ?? "Oshan Mudannayake | AI Researcher"
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
const ogImageUrl = new URL("/og.png", Astro.site).href

// The site name doubles as the <h1> on the homepage; every other page owns its
// own <h1>, so there it renders as a plain link back home instead.
const isHome = Astro.url.pathname.replace(/\/$/, "") === ""

const command = commandFor(Astro.url.pathname)

const personal = await getEntry("personal", "main")
const profileEntries: Record<string, ProfileEntry> = personal?.data.profile_entries ?? {}
const sameAs = Object.values(profileEntries).map((profile) => profile.url)

// The rail's role line comes from data/personal.yaml so it can never drift from
// the Typst CVs, which read the same fields.
const siteRole = [personal?.data.tagline_academic_role, personal?.data.tagline_academic_field]
    .filter(Boolean)
    .join(" · ")

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: `${personal?.data.first_name ?? "Oshan"} ${personal?.data.last_name ?? "Mudannayake"}`,
    url: Astro.site?.href,
    image: ogImageUrl,
    jobTitle: personal?.data.tagline_casual,
    knowsAbout: personal?.data.interests_casual?.split(",").map((interest: string) => interest.trim()),
    sameAs,
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#fbfaf7" />
        {
            /* Both generated from the 2000x2000 master in src/assets by
            `pnpm build:icons` and committed. The master itself used to be the
            favicon, which meant fetching 25.6 kB to fill 32 pixels. */
        }
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.json" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <link rel="alternate" type="application/rss+xml" title="Oshan Mudannayake — News" href="/rss.xml" />
        {
            /* The fonts are served from this origin now (src/styles/_fonts.scss),
            so the two preconnects to Google went with them. Real 600 cuts, not a
            synthesised bold off a single 400; the italic is load-bearing too —
            publication venues are set in it.

            These preloads exist because the @font-face blocks live in the
            stylesheet Astro appends at the *end* of <head>, below everything
            here. Without them the browser has to fetch that sheet, parse it, lay
            out, discover a glyph needs a face, and only then start the font — one
            round trip too many on a cold connection. A preload is picked up by
            the preload scanner before any CSSOM exists, so the fonts arrive
            alongside the stylesheet rather than behind it.

            Only the two upright Mono cuts, 20 kB together. Mono is the default
            body face and carries the rail, the nav, every h1 and every h3, so it
            is needed above the fold on every page without exception. The Mono
            italic and Sans (40 kB on its own, and absent from several pages
            entirely) are left to font-display: swap — putting either ahead of the
            stylesheet would delay the one resource that actually unblocks
            rendering in order to fetch bytes a given page may never use.

            `crossorigin` is not decoration. Fonts are fetched in CORS mode even
            same-origin, and a preload without it does not match the later font
            request: the file downloads twice and the preload becomes a net loss. */
        }
        <link
            rel="preload"
            href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/ibm-plex-mono-latin-600-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Oshan Mudannayake" />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Oshan Mudannayake — AI Researcher and ML Engineer" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@_ivantha" />
        <meta name="twitter:creator" content="@_ivantha" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
        {
            /* `arguments`, not a rest array — and this is not a style choice.
            gtag.js decides whether a dataLayer entry is a command by testing
            `Object.prototype.toString.call(entry) === "[object Arguments]"`. A
            real Array fails that test and gets routed to a legacy branch that
            reads entry[0] as a dotted method path and swallows the failure in a
            bare catch. The previous `(...args) => push(args)` form therefore
            dropped both commands silently, and since the "js" command is the only
            thing that emits the gtm.js event the GA4 configuration tag fires on,
            this property recorded nothing at all. Verified by A/B test against
            the live property: the array form sends zero /g/collect beacons, this
            form sends page_view.

            The bootstrap stays synchronous — it is ~200 bytes and it *is* the
            queue, so a command issued before gtag.js lands is buffered rather
            than lost. Only the fetch is deferred: gtag.js is ~160 kB over the
            wire against ~43 kB for this entire site, so it has no business
            competing with first paint.

            requestIdleCallback carries a timeout because a hidden tab may never
            report idle; the setTimeout branch covers Safari, which had no
            requestIdleCallback before 16.4.

            No preconnect to googletagmanager.com — opening that connection early
            is exactly the cost being deferred here. */
        }
        <script is:inline>
            window.dataLayer = window.dataLayer || []
            // `arguments` is the contract with gtag.js, not a legacy style, and
            // taking prefer-rest-params' advice here is what broke analytics
            // before: a rest array is not an Arguments object, gtag.js
            // type-checks for exactly that, and the mismatch fails silently.
            // Do not "modernise" this line.
            function gtag() {
                // eslint-disable-next-line prefer-rest-params
                window.dataLayer.push(arguments)
            }
            gtag("js", new Date())
            gtag("config", "G-9YY9CJLD5V")

            const loadGtag = () => {
                const tag = document.createElement("script")
                tag.async = true
                tag.src = "https://www.googletagmanager.com/gtag/js?id=G-9YY9CJLD5V"
                document.head.appendChild(tag)
            }

            const scheduleGtag = () => {
                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadGtag, { timeout: 3000 })
                } else {
                    window.setTimeout(loadGtag, 2000)
                }
            }

            // Wait for `load` before even asking for idle. Idle on its own is not
            // enough: on a fast connection the browser reports idle while it is
            // still fetching this page's own fonts and hero image, and gtag.js
            // then competes with them for bandwidth — measured starting at 10 ms
            // against a DOMContentLoaded of 34 ms. After `load` there is nothing
            // left of ours for it to take priority from.
            if (document.readyState === "complete") {
                scheduleGtag()
            } else {
                window.addEventListener("load", scheduleGtag, { once: true })
            }
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="container">
            {
                /* The name pins to the rail rather than scrolling away with a
                banner. On a personal site the name is the brand, and the old
                fixed 122px header cost that much vertical space on every page. */
            }
            <header class="rail">
                {
                    isHome ? (
                        <h1 class="site-name">Oshan Mudannayake</h1>
                    ) : (
                        <a class="site-name" href="/">
                            Oshan Mudannayake
                        </a>
                    )
                }
                {siteRole && <span class="site-role">{siteRole}</span>}
                <NavBar />
            </header>
            <main id="main">
                {
                    /* Restates the <h1> and the nav's aria-current, so it is
                    decorative to a screen reader rather than orientation. */
                }
                <p class="prompt" aria-hidden="true"><span class="sigil">$</span>{command}</p>
                <slot />
            </main>
        </div>
    </body>
</html>
