---
import { getEntry } from "astro:content"
import "@/styles/components/layout.scss"
import NavBar from "@/components/NavBar.astro"
import type { ProfileEntry } from "@/lib/contact"
import { commandFor } from "@/lib/prompt"

interface Props {
    title?: string
    description?: string
}

const { title, description = "Personal website of Oshan Mudannayake — AI Researcher and ML Engineer." } = Astro.props

const fullTitle = title ?? "Oshan Mudannayake | AI Researcher"
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
const ogImageUrl = new URL("/og.png", Astro.site).href

// The site name doubles as the <h1> on the homepage; every other page owns its
// own <h1>, so there it renders as a plain link back home instead.
const isHome = Astro.url.pathname.replace(/\/$/, "") === ""

const command = commandFor(Astro.url.pathname)

const personal = await getEntry("personal", "main")
const profileEntries: Record<string, ProfileEntry> = personal?.data.profile_entries ?? {}
const sameAs = Object.values(profileEntries).map((profile) => profile.url)

// The rail's role line comes from data/personal.yaml so it can never drift from
// the Typst CVs, which read the same fields.
const siteRole = [personal?.data.tagline_academic_role, personal?.data.tagline_academic_field]
    .filter(Boolean)
    .join(" · ")

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: `${personal?.data.first_name ?? "Oshan"} ${personal?.data.last_name ?? "Mudannayake"}`,
    url: Astro.site?.href,
    image: ogImageUrl,
    jobTitle: personal?.data.tagline_casual,
    knowsAbout: personal?.data.interests_casual?.split(",").map((interest: string) => interest.trim()),
    sameAs,
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#fbfaf7" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="manifest" href="/manifest.json" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <link rel="alternate" type="application/rss+xml" title="Oshan Mudannayake — News" href="/rss.xml" />
        {
            /* The fonts are served from this origin now (src/styles/_fonts.scss),
            so the two preconnects to Google went with them. Real 600 cuts, not a
            synthesised bold off a single 400; the italic is load-bearing too —
            publication venues are set in it.

            These preloads exist because the @font-face blocks live in the
            stylesheet Astro appends at the *end* of <head>, below everything
            here. Without them the browser has to fetch that sheet, parse it, lay
            out, discover a glyph needs a face, and only then start the font — one
            round trip too many on a cold connection. A preload is picked up by
            the preload scanner before any CSSOM exists, so the fonts arrive
            alongside the stylesheet rather than behind it.

            Only the two upright Mono cuts, 20 kB together. Mono is the default
            body face and carries the rail, the nav, every h1 and every h3, so it
            is needed above the fold on every page without exception. The Mono
            italic and Sans (40 kB on its own, and absent from several pages
            entirely) are left to font-display: swap — putting either ahead of the
            stylesheet would delay the one resource that actually unblocks
            rendering in order to fetch bytes a given page may never use.

            `crossorigin` is not decoration. Fonts are fetched in CORS mode even
            same-origin, and a preload without it does not match the later font
            request: the file downloads twice and the preload becomes a net loss. */
        }
        <link
            rel="preload"
            href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/ibm-plex-mono-latin-600-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Oshan Mudannayake" />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Oshan Mudannayake — AI Researcher and ML Engineer" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@_ivantha" />
        <meta name="twitter:creator" content="@_ivantha" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9YY9CJLD5V"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || []
            function gtag(...args) {
                window.dataLayer.push(args)
            }
            gtag("js", new Date())
            gtag("config", "G-9YY9CJLD5V")
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="container">
            {
                /* The name pins to the rail rather than scrolling away with a
                banner. On a personal site the name is the brand, and the old
                fixed 122px header cost that much vertical space on every page. */
            }
            <header class="rail">
                {
                    isHome ? (
                        <h1 class="site-name">Oshan Mudannayake</h1>
                    ) : (
                        <a class="site-name" href="/">
                            Oshan Mudannayake
                        </a>
                    )
                }
                {siteRole && <span class="site-role">{siteRole}</span>}
                <NavBar />
            </header>
            <main id="main">
                {
                    /* Restates the <h1> and the nav's aria-current, so it is
                    decorative to a screen reader rather than orientation. */
                }
                <p class="prompt" aria-hidden="true"><span class="sigil">$</span>{command}</p>
                <slot />
            </main>
        </div>
    </body>
</html>
